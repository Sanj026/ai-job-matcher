{
  "manifest_version": 3,
  "name": "AI Job Matcher",
  "version": "0.2.0",
  "description": "Match job postings against your resume and score their relevance from 0 to 10.",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus", "sidePanel"],
  "host_permissions": ["https://api.typesafe.ai/*"],
  "content_scripts": [{
    "matches": ["https://*.linkedin.com/*", "https://*.indeed.com/*", "https://*.glassdoor.com/*",
                "https://*.greenhouse.io/*", "https://*.ashbyhq.com/*", "https://*.builtin.com/*"],
    "js": ["content.js"]
  }],
  "background":{ "service_worker": "background.js" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "popup.html" },
  "options_page": "options.html"
}
